# Copy this file to .env and fill in real values.
# .env is loaded by config.py at startup and is listed in .gitignore --
# never commit your real .env file.

# ---- Secrets: keep these two separate; never reuse one as the other ----

# Authenticates ERA/Bridge -> this Vision Agent.
# Generate one with: python scripts\store_gemini_key.py --gen-vision-key
VISION_AGENT_API_KEY=

# Authenticates this Vision Agent -> Google Gemini.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ---- Network (must stay loopback; see config.py's __post_init__ guard) ----
VISION_AGENT_HOST=127.0.0.1
VISION_AGENT_PORT=8200

# Comma-separated list of origins allowed by CORS. Defaults to the Bridge
# running on 8100 if left blank.
ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100

# ---- Gemini model / budget ----
GEMINI_MODEL=gemini-2.5-flash
MAX_GEMINI_CALLS_PER_HOUR=120
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2

# ---- Capture / change detection tuning ----
CAPTURE_INTERVAL_SECONDS=1.0
IDLE_CAPTURE_INTERVAL_SECONDS=3.0
CHANGE_THRESHOLD=0.02
MIN_SECONDS_BETWEEN_ANALYSIS=2.0
DEBOUNCE_SECONDS=0.6

# ---- Visual context memory ----
CONTEXT_HISTORY_SIZE=10
CONTEXT_TTL_SECONDS=600

# ---- Privacy ----
# Comma-separated process names (e.g. keepass.exe,1password.exe) added to
# the built-in default list.
EXCLUDED_PROCESS_NAMES=

# Never set this to true unless you specifically want frames written to
# disk for debugging -- off by default per the Phase 2 requirement.
STORE_SCREENSHOTS_TO_DISK=false

# ---- Resource limits ----
MAX_CPU_PERCENT_SUSTAINED=35
MAX_RSS_MB=600

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Action Engine (Phase 3) ----
ERA_BRIDGE_URL=http://127.0.0.1:8100
ERA_BRIDGE_API_KEY=era_bridge_secret_key_2026
ACTION_ENGINE_ENABLED=true
ACTION_CONFIDENCE_THRESHOLD=0.65
ACTION_VERIFY_DELAY_SECONDS=3.0
MAX_ACTIONS_PER_HOUR=30
ACTION_COOLDOWN_SECONDS=15.0
ACTION_LOG_ONLY_MODE=false

# ---- Chart Analysis (Phase 3) ----
CHART_ANALYSIS_ENABLED=true
CHART_AUTO_SCROLL_ENABLED=true
CHART_SCROLL_CLICKS=5
CHART_ANALYSIS_COOLDOWN_SECONDS=5.0
CHART_HISTORY_SIZE=20

# ---- OCR (optional) ----
# Only needed if the Tesseract engine isn't on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
