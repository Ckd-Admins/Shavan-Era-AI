# ============================================================
# ERA Agent — Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# ── GMAIL OAUTH ─────────────────────────────────────────────
# Path to your downloaded OAuth2 credentials file from Google Cloud Console.
# Download: https://console.cloud.google.com/apis/credentials
# Type:     OAuth 2.0 Client ID — Desktop App
# Save as:  d:\era_agent\credentials.json
GMAIL_CREDENTIALS_PATH=credentials.json

# Path where ERA will store your Gmail access token after OAuth.
# This is created automatically after you authorize ERA.
GMAIL_TOKEN_PATH=token.json

# ── WHATSAPP BUSINESS CLOUD API ──────────────────────────────
# Meta Developer Portal: https://developers.facebook.com/apps/
# Required for real WhatsApp sending via WhatsApp Business Cloud API.
#
# Your permanent access token from Meta Developer Portal.
WHATSAPP_API_TOKEN=your_meta_permanent_access_token_here

# Your WhatsApp Business Phone Number ID (NOT the phone number itself).
# Found in: Meta App Dashboard → WhatsApp → Getting Started
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Token used to verify your webhook endpoint with Meta.
# Set this to any secret string you choose.
WHATSAPP_VERIFY_TOKEN=era_webhook_secret_2024

# ── ERA SYSTEM FLAGS ─────────────────────────────────────────
# Set to true to force mock mode (for testing without real credentials).
ERA_MOCK_MODE=false

# ── SERVER CONFIGURATION ─────────────────────────────────────
# ERA API server host and port (defaults shown).
ERA_HOST=127.0.0.1
ERA_PORT=8000
