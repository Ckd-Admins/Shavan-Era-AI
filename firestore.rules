rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper to check if a user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if the authenticated user's email matches the document ID (userId)
    function isOwner(userId) {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == userId.lower();
    }

    // Rules for users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Rules for chats subcollection
      match /chats/{chatId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
